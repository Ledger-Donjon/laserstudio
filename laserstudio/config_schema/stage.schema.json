{
  "$id": "stage.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage",
  "type": "object",
  "allOf": [
    {
      "$ref": "instrument.schema.json"
    }
  ],
  "properties": {
    "unit_factors": {
      "description": "The conversion factors for the stage's units, for each axis. Give one value if it is the same for all axes. Extra values are ignored and lacking values are set to last provided value.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "suffix": "um/unit",
        "default": 1.0
      }
    },
    "unit_factor": {
      "description": "Conversion factor for the stage's units. A single value applied to all axes (scalar alias of 'unit_factors').",
      "type": "number",
      "default": 1.0,
      "suffix": "um/unit"
    },
    "guardrail_um": {
      "description": "Maximum allowed move distance, in micrometers, as a safety guardrail.",
      "type": "number",
      "default": 20000.0,
      "minimum": 0.0,
      "suffix": "um"
    },
    "backlashes_um": {
      "description": "Backlash compensation for each axis, in micrometers.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "suffix": "um"
      }
    },
    "shear": {
      "description": "Shear correction factors applied to the X and Y axes.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "default": [0.0, 0.0],
      "items": {
        "type": "number"
      }
    }
  },
  "oneOf": [
    {
      "title": "Corvus",
      "allOf": [
        {
          "properties": {
            "type": {
              "const": "Corvus",
              "description": "A Corvus Stage."
            }
          }
        },
        {
          "$ref": "serial.schema.json"
        }
      ]
    },
    {
      "title": "CNC",
      "allOf": [
        {
          "properties": {
            "type": {
              "const": "CNC",
              "description": "A CNC Stage."
            }
          }
        },
        {
          "$ref": "serial.schema.json"
        }
      ]
    },
    {
      "title": "SMC100",
      "properties": {
        "type": {
          "const": "SMC100",
          "description": "A Newport SMC100."
        },
        "adresses": {
          "description": "Adresses.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          },
          "default": [1, 2]
        }
      }
    },
    {
      "title": "PI",
      "properties": {
        "type": {
          "const": "PI",
          "description": "A Physik Instrumente, Daisy-chain Mercury Servo Controller, or GCS-compatible."
        },
        "adresses": {
          "description": "Adresses.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          },
          "default": [1, 2, 3]
        }
      }
    },
    {
      "title": "Dummy",
      "properties": {
        "type": {
          "const": "Dummy",
          "description": "A Dummy Stage."
        },
        "num_axis": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Number of axes of the dummy stage."
        }
      },
      "required": ["num_axis"]
    },
    {
      "title": "REST",
      "properties": {
        "type": {
          "const": "REST",
          "description": "A Stage responding to a Rest API."
        }
      },
      "allOf": [
        {
          "$ref": "rest.schema.json"
        }
      ]
    }
  ],
  "required": ["type"]
}
